model ReportPeriods {
  id                Int                 @default(autoincrement())
  userId            String              
  reportId          Int                 
  monthName         MonthsList          
  monthIndex        Int                 @db.SmallInt          
  dateFrom          String              @db.VarChar(10)
  dateTo            String              @db.VarChar(10)


  @@unique([userId, dateFrom, dateTo])
  @@index([userId, dateFrom, dateTo])
}

enum MonthsList {
    январь
    февраль
    март
    апрель
    май
    июнь
    июль
    август
    сентябрь
    октябрь
    ноябрь
    декабрь
}